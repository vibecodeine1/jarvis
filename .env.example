##############################################
# JARVIS Gateway — Environment Configuration
# Copy to `.env` and fill in real values.
# NEVER commit the real `.env` file.
##############################################

# --- Telegram ---
# Create a bot with @BotFather, then create a Telegram GROUP (not channel),
# enable "Topics" in group settings, and add the bot as admin.
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_GROUP_CHAT_ID=-1001234567890
# Get thread IDs by right-clicking each topic -> "Copy Link" and reading the
# trailing number (t.me/c/<chat>/<thread_id>), or by logging incoming
# message_thread_id values from the bot the first time each topic is used.
TOPIC_ID_GENERAL=1
TOPIC_ID_YOUTUBE=2
TOPIC_ID_LINKEDIN=3
TOPIC_ID_NEWSLETTER=4
TOPIC_ID_FINANCE=5
TOPIC_ID_STRATEGY=6
TOPIC_ID_CHRIS=7
TOPIC_ID_ARTURO=8

# --- Claude Code / Anthropic ---
# Claude Code reads ANTHROPIC_API_KEY itself; the gateway only needs to know
# the CLI is on PATH. Run `claude` once interactively on the VPS first to
# authenticate (browser login or API key), see README.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-4-6

# --- Workspace ---
# Root folder containing CLAUDE.md, agents/, and per-topic working dirs.
JARVIS_WORKSPACE=/home/deploy/jarvis-assistant

# --- Google (Calendar + Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=<your-stripe-secret-key>

# --- GoHighLevel ---
GHL_API_KEY=
GHL_LOCATION_ID=

# --- beehiiv ---
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- Notion ---
NOTION_API_KEY=

# --- Trello ---
TRELLO_API_KEY=
TRELLO_TOKEN=

# --- Airtable ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- n8n (self-hosted webhook base) ---
N8N_WEBHOOK_BASE_URL=

# --- Xero ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- Apify ---
APIFY_API_TOKEN=

# --- Logging ---
LOG_LEVEL=info
TZ=America/New_York
